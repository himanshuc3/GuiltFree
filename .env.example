# Copy to .env (git-ignored). Everything here is a placeholder, not a real credential.
# With these defaults the server runs fully offline: mock Gmail, mock calorie estimator, in-memory store.

PORT=3000
# Shared secret the mobile app sends as x-api-key. Change it for anything beyond local dev.
APP_API_KEY=dev-api-key

# Leave empty to use the in-memory store (data is lost on restart).
MONGODB_URI=
MONGODB_DB=guiltfree

# mock = read fixtures/emails, google = Gmail API via OAuth
GMAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OpenAI-compatible endpoint serving an open-weight model (OpenRouter, Ollama, self-hosted...).
# Leave LLM_API_KEY empty to use the mock calorie estimator.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-3-27b-it

# Only orders delivered after this instant are counted. Defaults to first server start.
# For mock demos set it in the past.
TRACKING_SINCE=2026-10-01T00:00:00Z
# Mock mode re-dates fixture emails to "recent" so the demo always falls in the current week.
MOCK_REBASE_DATES=true
# Background Gmail poll interval; 0 disables.
SYNC_INTERVAL_SECONDS=120
